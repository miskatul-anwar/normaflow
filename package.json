{
  "name": "normaflow",
  "description": "Turn raw CSV files into normalized database schemas \u2014 ERDs, SQL DDL and normalization reports. Local-first desktop app built with Tauri + React.",
  "keywords": [
    "erd",
    "entity-relationship-diagram",
    "database-normalization",
    "csv-to-sql",
    "functional-dependencies",
    "3nf",
    "sql-generator",
    "mermaid",
    "tauri",
    "react"
  ],
  "license": "MIT",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miskatul-anwar/normaflow.git"
  },
  "homepage": "https://github.com/miskatul-anwar/normaflow#readme",
  "bugs": {
    "url": "https://github.com/miskatul-anwar/normaflow/issues"
  },
  "author": "Miskatul Anwar <miskatul.anwar.csecu@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "predev": "node scripts/prepare-nl-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-nl-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit --pretty",
    "cli": "tsx scripts/cli.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:nl": "tsx scripts/bench-nl.ts",
    "lint": "eslint . --max-warnings 383",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "fmt:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml",
    "audit:a11y": "node scripts/a11y-audit.cjs",
    "quality": "npm run typecheck && npm run lint && vitest run && npm audit --omit=dev --audit-level=high",
    "audit:ui": "node scripts/ui-audit.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@hpcc-js/wasm-graphviz": "^1.30.0",
    "@huggingface/transformers": "^4.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@xyflow/react": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^10.18.0",
    "github-markdown-css": "^5.8.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.294.0",
    "marked": "^18.2.0",
    "mermaid": "^11.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
