  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
