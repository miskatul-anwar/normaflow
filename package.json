{
  "name": "normaflow",
  "description": "Turn raw CSV files into normalized database schemas — ERDs, SQL DDL and normalization reports. Local-first desktop app built with Tauri + React.",
  "keywords": [
    "erd",
    "entity-relationship-diagram",
    "database-normalization",
    "csv-to-sql",
    "functional-dependencies",
    "3nf",
    "sql-generator",
    "mermaid",
    "tauri",
    "react"
  ],
  "license": "MIT",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miskatul-anwar/normaflow.git"
  },
  "homepage": "https://github.com/miskatul-anwar/normaflow#readme",
  "bugs": {
    "url": "https://github.com/miskatul-anwar/normaflow/issues"
  },
  "author": "Miskatul Anwar <miskatul.anwar.csecu@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "fmt:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
