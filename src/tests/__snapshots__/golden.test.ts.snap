    %% === PRIMARY ENTITIES (High Importance) ===
    orders {
        varchar order_id "PK"
        varchar order_date ""
        varchar total ""
        string confidence "[H] FD: 100%"
    }

    %% === RELATIONSHIPS (All Confidence Levels) ===

