// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden output > multi-file DDL (postgres) 1`] = `
"-- NormaFlow Relational Schema DDL
-- Dialect: POSTGRESQL
-- Generated: <time>

BEGIN;

CREATE TABLE "customers" (
  "customer_id" INTEGER PRIMARY KEY,
  "name" VARCHAR(16) NOT NULL
);

CREATE TABLE "orders" (
  "order_id" INTEGER PRIMARY KEY,
  "customer_id" INTEGER NOT NULL,
  "order_date" DATE NOT NULL,
  "total" DECIMAL(6,2) NOT NULL,
  CONSTRAINT "fk_orders_customer_id" FOREIGN KEY ("customer_id") REFERENCES "customers"("customer_id") ON DELETE CASCADE ON UPDATE CASCADE
);

COMMIT;
"
`;

exports[`golden output > multi-file DDL (sqlite) 1`] = `
"-- NormaFlow Relational Schema DDL
-- Dialect: SQLITE
-- Generated: <time>

PRAGMA foreign_keys = OFF;
BEGIN TRANSACTION;

CREATE TABLE "customers" (
  "customer_id" INTEGER PRIMARY KEY,
  "name" TEXT NOT NULL
);

CREATE TABLE "orders" (
  "order_id" INTEGER PRIMARY KEY,
  "customer_id" INTEGER NOT NULL,
  "order_date" TEXT NOT NULL,
  "total" DECIMAL(6,2) NOT NULL,
  CONSTRAINT "fk_orders_customer_id" FOREIGN KEY ("customer_id") REFERENCES "customers"("customer_id") ON DELETE CASCADE ON UPDATE CASCADE
);

COMMIT;
PRAGMA foreign_keys = ON;
"
`;

exports[`golden output > multi-file ER diagram 1`] = `
"erDiagram
    customers {
        int customer_id PK
        string name
    }
    orders {
        int order_id PK
        int customer_id FK
        date order_date
        decimal total
    }
    customers ||--o{ orders : "customer_id"
"
`;

exports[`golden output > single-file ER diagram and DDL 1`] = `
"erDiagram
