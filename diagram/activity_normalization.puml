@startuml
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

start

:Receive CSV Files from Ingestion;

partition "1. Ingestion & Semantic Profiling" {
  :Parse CSV in single pass;
  :Count nulls, integers, dates, distinct values;
  :Collect 24 deterministic sample values;
  :Execute Rule & Gazetteer Matcher on Column Names;
  :Execute Value Pattern & Regex Matcher on Samples;
  :Fuse Evidence Channels (resolve conflicting signals);
  :Assign EntityTag (PK, FK, EMAIL, PRICE, etc.);
}

partition "2. Functional Dependency Mining (TANE-style)" {
  :Intern and integer-encode column strings;
  :Compute initial single-attribute partitions;
  :Traverse LHS lattice level by level;
  while (More attribute combinations in lattice?) is (yes)
    :Refine partition from parent combinations;
    if (Refining pi(X) with Y introduces new equivalence classes?) then (no)
      :Record valid Functional Dependency X -> Y;
      :Prune supersets of determinants;
    else (yes)
      :Check if violation ratio < tolerance;
      if (Approximate FD?) then (yes)
        :Record approximate FD;
      else (no)
        :Discard combination;
      endif
    endif
  endwhile (no)
}

partition "3. Candidate Key Discovery" {
  :Initialize candidate key search over attribute powerset;
  while (Candidate set S in powerset?) is (yes)
    :Compute attribute closure S+ using mined FDs;
    if (Closure contains all table attributes?) then (yes)
      if (Is S minimal superkey?) then (yes)
        :Add S to CandidateKeys set;
      endif
    endif
  endwhile (no)
}

partition "4. 3NF Synthesis (Bernstein Decomposition)" {
  :Compute minimal cover of Functional Dependencies;
  :For each FD (X -> A), create relation R_i(X, A);
  :Merge relations with identical candidate keys;
  if (Does any relation contain a candidate key of original table?) then (no)
    :Add new relation R_key(PrimaryCandidateKey);
  endif
  :Eliminate redundant / subset relations;
  :Verify Lossless-Join Condition;
}

partition "5. Output Generation" {
  :Detect cross-table foreign keys via naming & value-containment;
  :Synthesize sanitized Mermaid ERD string;
  :Synthesize PostgreSQL/SQLite SQL DDL script;
  :Generate Markdown Normalization Report;
}

:Emit ProcessingResult to UI;

stop
@enduml
