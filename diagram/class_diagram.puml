@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

package "Frontend: Domain Models & Types" {
  class TableStats {
    + tableName: string
    + rowCount: number
    + columns: ColumnStats[]
  }

  class ColumnStats {
    + name: string
    + filledCount: number
    + nullCount: number
    + distinctCount: number
    + inferredType: DataType
    + entityTag: EntityTag
    + samples: string[]
  }

  enum DataType {
    INTEGER
    NUMERIC
    DATE
    TEXT
    BOOLEAN
    UUID
  }

  enum EntityTag {
    PRIMARY_KEY_ID
    FOREIGN_KEY_REF
    EMAIL
    PHONE
    PERSON_NAME
    CURRENCY_PRICE
    DATE_TIME
    LOCATION
    STATUS_CODE
    DESCRIPTION
    UNKNOWN
  }

  class FunctionalDependency {
    + lhs: string[]
    + rhs: string
    + confidence: number
    + isExact: boolean
    + violationCount: number
  }

  class DecomposedRelation {
    + name: string
    + attributes: string[]
    + candidateKeys: string[][]
    + primaryKey: string[]
    + foreignKeys: ForeignKeyRef[]
    + sourceNormalForm: NormalForm
  }

  class ProcessingResult {
    + success: boolean
    + tables: TableStats[]
    + functionalDependencies: Map<string, FunctionalDependency[]>
    + candidateKeys: Map<string, string[][]>
    + relations3NF: DecomposedRelation[]
    + erdMermaid: string
    + sqlDdl: string
    + reportMarkdown: string
    + error: string
  }

  TableStats "1" *-- "many" ColumnStats
  ColumnStats --> DataType
  ColumnStats --> EntityTag
  ProcessingResult *-- TableStats
  ProcessingResult *-- FunctionalDependency
  ProcessingResult *-- DecomposedRelation
}

package "Frontend: Services & Algorithms" {
  class DatabaseService {
    + processFiles(files: File[], ops: string[]): Promise<ProcessingResult>
    - runNativeEngine(files: File[], ops: string[]): Promise<ProcessingResult>
    - runFallbackEngine(files: File[], ops: string[]): Promise<ProcessingResult>
  }

  class FdMiner {
    + mineDependencies(rows: Record<string, string>[], cols: string[]): FunctionalDependency[]
    - computePartition(colValues: number[]): Map<number, number[]>
    - refinePartition(parent: number[][], next: number[]): number[][]
    - pruneLattice(lhs: string[]): boolean
  }

  class NormalizationEngine {
    + findCandidateKeys(fds: FunctionalDependency[], allCols: string[]): string[][]
    + computeClosure(attrs: string[], fds: FunctionalDependency[]): Set<string>
    + decomposeTo3NF(relations: TableStats[], fds: FunctionalDependency[]): DecomposedRelation[]
    + verifyLosslessJoin(original: string[], decomposed: string[][], fds: FunctionalDependency[]): boolean
  }

  class SemanticProfiler {
    + profileColumn(name: string, samples: string[], distinctRatio: number): EntityTag
    - matchGazetteer(name: string): EntityTag
    - matchValuePatterns(samples: string[]): EntityTag
    - resolveEvidenceChannel(nameTag: EntityTag, valueTag: EntityTag): EntityTag
  }

  DatabaseService --> FdMiner
  DatabaseService --> NormalizationEngine
  DatabaseService --> SemanticProfiler
}

package "Frontend: UI State Hooks" {
  class useWorkflowGraph {
    + nodes: Node[]
    + edges: Edge[]
    + canUndo: boolean
    + canRedo: boolean
    + tryAddOperation(label: string): boolean
    + undo(): void
    + redo(): void
    + serializeSnapshot(): WorkflowSnapshot
    + loadSnapshot(raw: string | object): boolean
  }

  class useNormalization {
    + isProcessing: boolean
    + progress: ProgressState
    + processFiles(files: File[], ops: string[]): Promise<ProcessingResult>
  }
}

package "Rust Backend: Native Core" {
  class RustEngine {
    + process_multi_csv_rust(files: Vec<FileInput>): Result<ProcessingResult, String>
  }

  class CsvParser {
    + parse_csv_stream(name: String, bytes: &[u8]): Result<TableStats, String>
    - sample_values(raw: &str): String
  }

  class FkDetector {
    + detect_foreign_keys(tables: &[TableStats]): Vec<ForeignKeyCandidate>
    - verify_value_containment(src: &[String], target: &[String]): f64
  }

  class ErdGenerator {
    + generate_mermaid_erd(tables: &[TableStats], fks: &[ForeignKeyCandidate]): String
    - sanitize_identifier(raw: &str): String
  }

  class SqlGenerator {
    + generate_ddl(relations: &[DecomposedRelation]): String
    - map_sqlite_type(t: DataType): &'static str
  }

  RustEngine --> CsvParser
  RustEngine --> FkDetector
  RustEngine --> ErdGenerator
  RustEngine --> SqlGenerator
}

DatabaseService ..> RustEngine : Tauri IPC (invoke)
@enduml
