@startuml
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

[*] --> Idle : Application Launch

state Idle {
  [*] --> StartNodeOnly
  StartNodeOnly --> BuildingGraph : tryAddOperation(label)
  BuildingGraph --> BuildingGraph : Add / Remove / Reorder Nodes
  BuildingGraph --> StartNodeOnly : clearGraph()
  BuildingGraph --> GraphValidated : validateSequence() == true
  BuildingGraph --> SequenceBlocked : missingDependencies / invalidOrder
  SequenceBlocked --> BuildingGraph : Resolve Prerequisite Ops
}

Idle --> Executing : onRun() / onRunAll() [hasFiles && hasOperations]

state Executing {
  [*] --> IngestingCSV
  IngestingCSV --> ClassifyingNER : Streaming Parse Complete
  ClassifyingNER --> MiningFDs : Column Types Profiled
  MiningFDs --> KeyDiscovery : Partition Refinement Done
  KeyDiscovery --> Decomposing3NF : Candidate Keys Found
  Decomposing3NF --> SynthesizingArtifacts : Lossless Join Verified
  SynthesizingArtifacts --> ExecutionSuccess : ERD + SQL + Report Generated
  
  IngestingCSV --> ExecutionFailed : Malformed CSV / Error
  MiningFDs --> ExecutionFailed : Algorithmic Error
}

ExecutionFailed --> Idle : Display Error Message
ExecutionSuccess --> ResultReady : Cache Stored in LocalStorage & State

state ResultReady {
  [*] --> ViewingResults
  ViewingResults --> InspectingERD : Select ERD Tab
  ViewingResults --> InspectingDDL : Select SQL Tab
  ViewingResults --> InspectingReport : Select Report Tab
  ViewingResults --> ExportingFile : Download .mmd / .sql / .md
}

ResultReady --> Idle : Modify Workflow / Upload New CSV
@enduml
