@startuml
skinparam componentStyle uml2
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12

package "NormaFlow Desktop Client (WebView / React 18)" {
  [App Viewport] as AppView
  [Heading Toolbar] as Header
  [Operation Palette] as Palette
  [FlowCanvas (React Flow)] as Canvas
  [Output Explorer] as OutputView

  package "UI Hook Layer" {
    [useWorkflowGraph] as GraphHook
    [useNormalization] as NormHook
  }

  package "TypeScript Processing Layer" {
    [databaseService] as DBService
    [fdMiner (TANE Algorithm)] as FDMiner
    [normalizationEngine (3NF)] as NormEngine
    [semanticProfiler (NLP)] as NLPProfiler
    [resultCache] as Cache
  }

  AppView --> Header
  AppView --> Palette
  AppView --> Canvas
  AppView --> OutputView

  Header --> GraphHook
  Palette --> GraphHook
  Canvas --> GraphHook
  Header --> NormHook
  NormHook --> DBService

  DBService --> FDMiner
  DBService --> NormEngine
  DBService --> NLPProfiler
  DBService --> Cache
}

cloud "Tauri 2 IPC Bridge (invoke / serialize)" as IPC

package "Native Rust Backend (src-tauri)" {
  [lib.rs Entrypoint] as RustLib

  package "Rust Core Engine (engine/)" {
    [engine::csv (Streaming Multi-Thread Parser)] as RustCSV
    [ner (Semantic Classifier & Gazetteer)] as RustNER
    [engine::fk (Value-Overlap Verifier)] as RustFK
    [engine::erd (Mermaid Generator)] as RustERD
    [engine::sql (DDL Synthesizer)] as RustSQL
    [engine::report (Markdown Generator)] as RustReport
  }

  package "Persistence" {
    [db.rs (SQLite In-Memory History)] as SQLiteDB
  }

  RustLib --> RustCSV
  RustLib --> RustNER
  RustLib --> RustFK
  RustLib --> RustERD
  RustLib --> RustSQL
  RustLib --> RustReport
  RustLib --> SQLiteDB
}

DBService ..> IPC : JSON Ingest Payload
IPC ..> RustLib : Command Dispatch: 'process_multi_csv_rust'
RustLib ..> IPC : ProcessingResult Envelope
IPC ..> DBService : Hydrate State
@enduml
